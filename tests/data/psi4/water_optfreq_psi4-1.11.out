# H2O_B3LYP_def2-SVP
memory 2000 mb

molecule {
0 1
O   0.00640000  0.39330000  0.00000000
H  -0.77390000 -0.17900000  0.00000000
H   0.76750000 -0.21430000  0.00000000
symmetry c1
}

set {
  basis def2-svp
  reference rks
  scf_type df
  e_convergence 8
  d_convergence 8
  geom_maxiter 100
}

optimize('b3lyp')
frequency('b3lyp')
