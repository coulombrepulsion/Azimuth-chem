&CONTROL
  calculation = 'scf'
  prefix = 'azimuth'
  pseudo_dir = '/pseudo'
  outdir = './out'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 45
  ecutrho = 360
/
&ELECTRONS
  conv_thr = 2.0e-08
/
